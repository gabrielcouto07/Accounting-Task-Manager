# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# Variaveis reais do ambiente/servico tem prioridade sobre o que estiver aqui.
# O arquivo ".env" NAO vai para o git.

# --- Banco de dados -------------------------------------------------------
# Mantenha o banco FORA da pasta do codigo para poder trocar a versao do
# sistema sem encostar nos dados de producao.
DATABASE_URL=sqlite:///C:/data/gerenciado-contabil/controle_contabil.db

# --- Sessao ---------------------------------------------------------------
# Texto longo e aleatorio. Sem isso o sistema gera um e grava em .session_secret.
# Trocar este valor desloga todo mundo (nao apaga dado nenhum).
SESSION_SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
SESSION_COOKIE_NAME=gerenciado_contabil_session
# Tempo de vida do login, em segundos. 43200 = 12 horas.
SESSION_MAX_AGE=43200
# Deixe "false" enquanto o acesso for por http:// na rede interna.
SESSION_HTTPS_ONLY=false

# --- E-mail (chamados e tarefas extraordinarias) --------------------------
SMTP_USER=conta-de-envio@scientificdental.com
SMTP_PASSWORD=senha-ou-app-password
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_FROM=conta-de-envio@scientificdental.com
SMTP_TLS=true
SMTP_TIMEOUT=15
EXTRA_TASK_EMAILS=apoio.informatica@scientificdental.com,informatica@scientificdental.com

# --- Log ------------------------------------------------------------------
LOG_LEVEL=INFO
